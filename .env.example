# Copy to .env and adjust. Never commit a real .env.
# Every setting is read by wrc_pipeline.config.Settings (env prefix: WRC_).

# --- target site ---------------------------------------------------------------
WRC_SOURCE=workplacerelations.ie
WRC_BASE_URL=https://www.workplacerelations.ie
WRC_SEARCH_PATH=/en/search/
WRC_ADVANCED_SEARCH_PATH=/en/search/?advance=true
# Fallback only: the real page size is read from the first results page of each partition.
WRC_RESULTS_PER_PAGE=10

# --- partitioning --------------------------------------------------------------
# daily | weekly | monthly | yearly
WRC_PARTITION_SIZE=monthly

# --- MongoDB -------------------------------------------------------------------
WRC_MONGO_URI=mongodb://localhost:27017
WRC_MONGO_DATABASE=wrc_landing
WRC_MONGO_LANDING_COLLECTION=landing_documents
WRC_MONGO_STATE_COLLECTION=landing_state

# --- S3 / MinIO ----------------------------------------------------------------
# Leave WRC_S3_ENDPOINT_URL empty to talk to real AWS S3, and leave the two key settings
# unset there so boto3 uses the standard AWS credential chain (env, shared config, IAM
# role). The values below are the local MinIO defaults from docker-compose.yml.
WRC_S3_ENDPOINT_URL=http://localhost:9000
WRC_S3_REGION=us-east-1
WRC_S3_ACCESS_KEY_ID=minioadmin
WRC_S3_SECRET_ACCESS_KEY=minioadmin
WRC_LANDING_BUCKET=wrc-landing
WRC_S3_CREATE_BUCKET=true

# --- Scrapy tuning -------------------------------------------------------------
WRC_CONCURRENT_REQUESTS=8
WRC_CONCURRENT_REQUESTS_PER_DOMAIN=4
WRC_DOWNLOAD_DELAY=0.25
WRC_REQUEST_TIMEOUT=60
WRC_RETRY_TIMES=4
WRC_AUTOTHROTTLE_ENABLED=true
WRC_AUTOTHROTTLE_TARGET_CONCURRENCY=2.0
WRC_AUTOTHROTTLE_MAX_DELAY=30.0
WRC_ROBOTSTXT_OBEY=true
WRC_USER_AGENT=wrc-pipeline/0.1 (+https://github.com/Kevinabizeiddaou/scrapy; research/archival)

# --- logging -------------------------------------------------------------------
WRC_LOG_LEVEL=INFO
